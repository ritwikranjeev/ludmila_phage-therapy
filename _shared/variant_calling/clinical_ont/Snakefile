rule mutation_table_manuscript:
    input:
        paper="tables/variants_for_paper.tsv",
        highconf="tables/variants_highconf_summary.tsv",
        mutations="tables/mutations.tsv",
        gff=f"annotation/snpeff/data/{snpeff_genome_id()}/genes.gff",
        focus_tags=lambda w: config.get("wta_focus_locus_tags", "resources/focus_locus_tags.txt"),
    output:
        tsv="tables/mutation_table_for_manuscript.tsv",
        md="tables/mutation_table_for_manuscript.md",
        tex="tables/mutation_table_for_manuscript.tex",
    conda:
        "envs/variant_postprocess.yaml"
    resources:
        runtime=10,
        mem_mb=2048,
    shell:
        """
        set -euo pipefail
        mkdir -p tables
        "$CONDA_PREFIX/bin/python" scripts/make_mutation_table_manuscript.py \
          --paper {input.paper} \
          --highconf {input.highconf} \
          --mutations {input.mutations} \
          --gff {input.gff} \
          --focus-tags {input.focus_tags} \
          --tsv-out {output.tsv} \
          --md-out {output.md} \
          --tex-out {output.tex}
        """


rule mutation_table:
    input:
        expand("vcf/{s}.snv.snpeff.vcf.gz", s=samples()),
    output:
        "tables/mutations.tsv",
    conda:
        "envs/annotation.yaml"
    resources:
        runtime=30,
        mem_mb=4096,
    params:
        ref_label=lambda w: ref_sample(),
        qry_label=lambda w: query_sample(),
        vcf_args=lambda w: " ".join(
            f"--vcf {s}:vcf/{s}.snv.snpeff.vcf.gz" for s in samples()
        ),
    shell:
        """
        mkdir -p tables
        python scripts/make_mutation_table.py --output {output} \
          --reference {params.ref_label} --query {params.qry_label} \
          {params.vcf_args}
        """


rule summary_report:
    input:
        quast="qc/quast/comparison/report.html",
        muts="tables/mutations.tsv",
    output:
        "reports/summary.md",
    resources:
        runtime=10,
        mem_mb=2048,
    run:
        with open(output[0], "w") as fh:
            fh.write("# MRSA ONT pre vs post summary\n\n")
            fh.write(f"- QUAST: `{input.quast}`\n")
            fh.write(f"- Mutation table: `{input.muts}`\n")
