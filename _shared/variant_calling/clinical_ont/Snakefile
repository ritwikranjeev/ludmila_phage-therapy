# MRSA ONT comparative workflow (pre vs post phage). Snakemake 8+.
# Run from this directory: LudmilaCharacterization/analyses/MRSA_ONT_comparative/
# Local:  snakemake -p --use-conda --conda-prefix .snakemake/conda
# HPC3:   snakemake -p --profile profile/slurm --use-conda --conda-prefix /path/on/scratch/conda

import os

configfile: "config/config.yaml"


def samples():
    return list(config["samples"].keys())


def ref_sample():
    return config.get("reference_sample", "pre")


def query_sample():
    q = config.get("query_sample")
    if q:
        return q
    ref = ref_sample()
    others = [s for s in samples() if s != ref]
    if len(others) != 1:
        raise ValueError(
            "Set config 'query_sample' when there is not exactly one non-reference isolate."
        )
    return others[0]


def genome_size():
    return config.get("genome_size", "3m")


def flye_mode():
    return config.get("flye_read_type", "nano-raw")


def reads_fq(wildcards):
    s = wildcards.sample
    if config.get("run_filtlong", False):
        return f"data/fastq/{s}.filtlong.fastq.gz"
    return f"data/fastq/{s}.fastq"


def ref_fasta():
    return f"assemblies/{ref_sample()}.polished.fasta"


def qry_fasta():
    return f"assemblies/{query_sample()}.polished.fasta"


def snpeff_genome_id():
    """SnpEff custom DB id; directory is annotation/snpeff/data/<id>/."""
    return config.get("snpeff_genome", "mrsa_ref_pre")


def snpeff_config_path():
    return "annotation/snpeff/snpEff.config"


def snpeff_db_bin():
    return f"annotation/snpeff/data/{snpeff_genome_id()}/snpEffectPredictor.bin"


def highconf_sample():
    return config.get("highconf_sample", query_sample())


# ---------------------------------------------------------------------------
rule all:
    input:
        expand("qc/{s}/fastqc.done", s=samples()),
        expand("qc/{s}/nanoplot/NanoPlot-report.html", s=samples()),
        expand("assemblies/{s}.polished.fasta", s=samples()),
        "qc/quast/comparison/report.html",
        "comparisons/pre_vs_post.snps.tsv",
        "comparisons/dnadiff.report",
        expand("alignments/{s}.sorted.bam.bai", s=samples()),
        "vcf/unique_post.snvs.vcf.gz",
        "vcf/unique_post.svs.vcf.gz",
        f"annotation/prokka/{ref_sample()}/{ref_sample()}.gff",
        snpeff_db_bin(),
        expand("vcf/{s}.snv.snpeff.vcf.gz", s=samples()),
        "tables/mutations.tsv",
        f"vcf/{highconf_sample()}.highconf.vcf.gz",
        f"vcf/{highconf_sample()}.clair3.vcf.gz",
        f"vcf/{highconf_sample()}.clair3.snpeff.vcf.gz",
        "tables/variants_highconf_summary.tsv",
        "tables/variants_WTA_envelope.tsv",
        "tables/variants_for_paper.tsv",
        "tables/mutation_table_for_manuscript.tsv",
        "tables/mutation_table_for_manuscript.md",
        "tables/mutation_table_for_manuscript.tex",
        "reports/summary.md",
        "figures/genome_alignment_main_chrom.png",
        "figures/genome_alignment_overview_all_contigs.png",
        "figures/genome_map_mauve_style.png",


# ---------------------------------------------------------------------------
rule stage_fastq:
    output:
        "data/fastq/{sample}.fastq",
    params:
        src=lambda w: config["samples"][w.sample]["fastq"],
    conda:
        "envs/ont_qc.yaml"
    resources:
        runtime=30,
        mem_mb=4096,
    shell:
        """
        mkdir -p data/fastq
        ln -srf {params.src} {output} 2>/dev/null || ln -sf "$(readlink -f {params.src})" {output}
        """


# ---------------------------------------------------------------------------
rule fastqc:
    input:
        reads_fq,
    output:
        touch("qc/{sample}/fastqc.done"),
    params:
        outdir="qc/{sample}/fastqc",
    conda:
        "envs/ont_qc.yaml"
    threads: 4
    resources:
        runtime=120,
        mem_mb=8192,
    shell:
        "mkdir -p {params.outdir} && fastqc -t {threads} -o {params.outdir} {input}"


rule nanoplot:
    input:
        reads_fq,
    output:
        "qc/{sample}/nanoplot/NanoPlot-report.html",
    conda:
        "envs/ont_qc.yaml"
    threads: 4
    resources:
        runtime=180,
        mem_mb=8192,
    shell:
        "mkdir -p qc/{wildcards.sample}/nanoplot && NanoPlot -t {threads} -o qc/{wildcards.sample}/nanoplot --fastq {input}"


rule filtlong:
    input:
        "data/fastq/{sample}.fastq",
    output:
        "data/fastq/{sample}.filtlong.fastq.gz",
    conda:
        "envs/ont_qc.yaml"
    threads: 8
    resources:
        runtime=240,
        mem_mb=16384,
    shell:
        "filtlong --min_length 1000 --keep_percent 95 {input} | gzip > {output}"


# ---------------------------------------------------------------------------
rule assembly_flye:
    input:
        reads_fq,
    output:
        dir=directory("assembly/{sample}/flye"),
        fasta="assembly/{sample}/flye/assembly.fasta",
    conda:
        "envs/ont_flye.yaml"
    threads: 16
    resources:
        runtime=2880,
        mem_mb=65536,
    params:
        gsize=lambda w: genome_size(),
        mode=lambda w: flye_mode(),
    shell:
        """
        mkdir -p {output.dir}
        # Flye's conda script uses #!/usr/bin/env python; on some compute nodes that is system Python (no flye module).
        "$CONDA_PREFIX/bin/python" "$CONDA_PREFIX/bin/flye" --{params.mode} {input} --genome-size {params.gsize} --out-dir {output.dir} --threads {threads}
        """


rule copy_flye_assembly:
    input:
        "assembly/{sample}/flye/assembly.fasta",
    output:
        "assemblies/{sample}.flye.fasta",
    conda:
        "envs/ont_flye.yaml"
    resources:
        runtime=15,
        mem_mb=2048,
    shell:
        "mkdir -p assemblies && cp -L {input} {output}"


# ---------------------------------------------------------------------------
rule minimap2_racon_paf_r1:
    input:
        asm="assemblies/{sample}.flye.fasta",
        fq=reads_fq,
    output:
        "assembly/{sample}/racon/r1.paf",
    conda:
        "envs/ont_polish.yaml"
    threads: 12
    resources:
        runtime=720,
        mem_mb=32768,
    shell:
        "mkdir -p assembly/{wildcards.sample}/racon && minimap2 -x map-ont -t {threads} {input.asm} {input.fq} > {output}"


