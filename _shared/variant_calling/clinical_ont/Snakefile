# ---------------------------------------------------------------------------
rule medaka_polish:
    input:
        reads=reads_fq,
        draft="assembly/{sample}/racon/r2.fasta",
    output:
        "assembly/{sample}/medaka/consensus.fasta",
    conda:
        "envs/ont_polish.yaml"
    threads: 8
    resources:
        runtime=1440,
        mem_mb=65536,
    params:
        model=lambda w: config["medaka_model"],
        outdir=lambda w: f"assembly/{w.sample}/medaka",
    shell:
        """
        rm -rf {params.outdir}
        # medaka_consensus calls `medaka`; its launcher uses #!/usr/bin/env python (breaks on some compute nodes).
        MWRAP="$PWD/.snakemake/medaka_wrap_{wildcards.sample}"
        mkdir -p "$MWRAP"
        printf '%s\n' '#!/usr/bin/env bash' 'exec "$CONDA_PREFIX/bin/python" "$CONDA_PREFIX/bin/medaka" "$@"' > "$MWRAP/medaka"
        chmod +x "$MWRAP/medaka"
        export PATH="$MWRAP:$CONDA_PREFIX/bin:$PATH"
        medaka_consensus -i {input.reads} -d {input.draft} -o {params.outdir} -t {threads} -m {params.model}
        """


rule copy_polished_assembly:
    input:
        "assembly/{sample}/medaka/consensus.fasta",
    output:
        "assemblies/{sample}.polished.fasta",
    conda:
        "envs/ont_polish.yaml"
    resources:
        runtime=15,
        mem_mb=2048,
    shell:
        "mkdir -p assemblies && cp -L {input} {output}"


# ---------------------------------------------------------------------------
rule quast_comparison:
    input:
        expand("assemblies/{s}.polished.fasta", s=samples()),
    output:
        "qc/quast/comparison/report.html",
    conda:
        "envs/qc.yaml"
    threads: 8
    resources:
        runtime=180,
        mem_mb=16384,
    params:
        # QUAST expects one --labels argument: comma-separated names (not two words).
        labels=lambda w: ",".join(samples()),
    shell:
        """
        rm -rf qc/quast/comparison
        mkdir -p qc/quast/comparison
        "$CONDA_PREFIX/bin/python" "$CONDA_PREFIX/bin/quast.py" {input} -o qc/quast/comparison --threads {threads} --labels {params.labels}
        """


rule busco_assembly:
    input:
        "assemblies/{sample}.polished.fasta",
    output:
        directory("qc/busco/{sample}/busco_run"),
    conda:
        "envs/qc.yaml"
    threads: 16
    resources:
        runtime=720,
        mem_mb=32768,
    params:
        lineage=lambda w: config.get("busco_lineage", "bacteria_odb10"),
        outdir="qc/busco/{sample}",
    shell:
        """
        mkdir -p {params.outdir}
        busco -i {input} -l {params.lineage} -o busco_run -m genome --cpu {threads} --out_path {params.outdir}
        """


# ---------------------------------------------------------------------------
rule nucmer_align:
    input:
        ref=lambda w: ref_fasta(),
        qry=lambda w: qry_fasta(),
    output:
        delta="comparisons/pre_vs_post.delta",
    conda:
        "envs/qc.yaml"
    threads: 8
    resources:
        runtime=360,
        mem_mb=32768,
    shell:
        """
        mkdir -p comparisons
        nucmer --maxmatch -p comparisons/pre_vs_post {input.ref} {input.qry}
        """


rule mummer_snps:
    input:
        "comparisons/pre_vs_post.delta",
    output:
        "comparisons/pre_vs_post.snps.tsv",
    conda:
        "envs/qc.yaml"
    resources:
        runtime=60,
        mem_mb=8192,
    shell:
        "show-snps -H -T -l {input} > {output}"


rule mummer_dnadiff:
    input:
        ref=lambda w: ref_fasta(),
        qry=lambda w: qry_fasta(),
    output:
        "comparisons/dnadiff.report",
    conda:
        "envs/qc.yaml"
    threads: 4
    resources:
        runtime=180,
        mem_mb=16384,
    shell:
        "mkdir -p comparisons && dnadiff -p comparisons/dnadiff {input.ref} {input.qry}"


rule mummer_dotplot:
    input:
        "comparisons/pre_vs_post.delta",
    output:
        "comparisons/pre_vs_post.gp",
    conda:
        "envs/qc.yaml"
    resources:
        runtime=30,
        mem_mb=4096,
    params:
        r=lambda w: ref_fasta(),
        q=lambda w: qry_fasta(),
    shell:
        "mummerplot -R {params.r} -Q {params.q} --postscript -p comparisons/pre_vs_post {input}"


rule figure_genome_alignment_main:
    input:
        delta="comparisons/pre_vs_post.delta",
        ref=lambda w: ref_fasta(),
        qry=lambda w: qry_fasta(),
    output:
        png="figures/genome_alignment_main_chrom.png",
    conda:
        "envs/qc.yaml"
    params:
        ref_contig=lambda w: config.get("alignment_plot_ref_contig", "contig_2"),
    resources:
        runtime=30,
        mem_mb=4096,
    shell:
        """
        set -euo pipefail
        mkdir -p figures
        QRY=$(python scripts/pick_primary_query_contig.py {input.delta} {params.ref_contig})
        TITLE="nucmer: ref {params.ref_contig} (pre) vs ${{QRY}} (post)"
        mummerplot -R {input.ref} -Q {input.qry} -r {params.ref_contig} -q "$QRY" --large \\
          -t png -title "$TITLE" -p figures/.tmp_mainchrom {input.delta}
        mv -f figures/.tmp_mainchrom.png {output.png}
        rm -f figures/.tmp_mainchrom.gp figures/.tmp_mainchrom.fplot figures/.tmp_mainchrom.rplot
        """


rule figure_genome_alignment_overview:
    input:
        delta="comparisons/pre_vs_post.delta",
        ref=lambda w: ref_fasta(),
        qry=lambda w: qry_fasta(),
    output:
        png="figures/genome_alignment_overview_all_contigs.png",
    conda:
        "envs/qc.yaml"
    resources:
        runtime=60,
        mem_mb=8192,
    shell:
        """
        set -euo pipefail
        mkdir -p figures
        mummerplot -R {input.ref} -Q {input.qry} --layout --filter --large \\
          -t png -title "nucmer pre vs post (all contigs, 1:1 filtered)" \\
          -p figures/.tmp_overview {input.delta}
        mv -f figures/.tmp_overview.png {output.png}
        rm -f figures/.tmp_overview.filter figures/.tmp_overview.gp figures/.tmp_overview.fplot \\
          figures/.tmp_overview.rplot
        """


rule figure_mauve_style_genome:
    input:
        delta="comparisons/pre_vs_post.delta",
        ref=lambda w: ref_fasta(),
        qry=lambda w: qry_fasta(),
        gff=lambda w: f"annotation/snpeff/data/{snpeff_genome_id()}/genes.gff",
        muts="tables/mutations.tsv",
    output:
        "figures/genome_map_mauve_style.png",
    conda:
        "envs/figures_mauve.yaml"
    params:
        ref_contig=lambda w: config.get("alignment_plot_ref_contig", "contig_2"),
        ref_label=lambda w: f"{ref_sample()}",
        qry_label=lambda w: f"{query_sample()}",
    resources:
        runtime=120,
        mem_mb=4096,
    shell:
        """
        set -euo pipefail
        mkdir -p figures
        QRY=$(python scripts/pick_primary_query_contig.py {input.delta} {params.ref_contig})
        python scripts/plot_mauve_style_alignment.py \\
          --delta {input.delta} \\
          --ref-fasta {input.ref} \\
          --qry-fasta {input.qry} \\
          --ref-contig {params.ref_contig} \\
          --qry-contig "$QRY" \\
          --gff {input.gff} \\
          --mutations {input.muts} \\
          --ref-label '{params.ref_label}' \\
          --qry-label '{params.qry_label}' \\
          -o {output}
        """


# ---------------------------------------------------------------------------
rule minimap2_to_ref:
    input:
        reads=reads_fq,
        ref=lambda w: ref_fasta(),
    output:
        bam="alignments/{sample}.sorted.bam",
        bai="alignments/{sample}.sorted.bam.bai",
    conda:
        "envs/variants.yaml"
    threads: 12
    resources:
        runtime=720,
        mem_mb=32768,
    shell:
        """
        mkdir -p alignments
        minimap2 -ax map-ont -t {threads} {input.ref} {input.reads} \
          | samtools sort -@ {threads} -o {output.bam} -
        samtools index {output.bam}
        """


rule call_clair3:
    input:
        bam="alignments/{sample}.sorted.bam",
        ref=lambda w: ref_fasta(),
    output:
        "vcf/{sample}.clair3.vcf.gz",
    conda:
        "envs/clair3.yaml"
    threads: 8
    resources:
        runtime=1440,
        mem_mb=65536,
    params:
        outdir=lambda w: os.path.join("vcf", f"clair3_{w.sample}"),
        model=lambda w: config.get("clair3_model_path", "/path/to/Clair3_models"),
        bin=lambda w: config.get("clair3_bin", "run_clair3.sh"),
        platform=lambda w: config.get("clair3_platform", "ont"),
        snp_min_af=lambda w: config.get("clair3_snp_min_af", 0.10),
        indel_min_af=lambda w: config.get("clair3_indel_min_af", 0.15),
        var_pct_full=lambda w: config.get("clair3_var_pct_full", 0.3),
        ref_pct_full=lambda w: config.get("clair3_ref_pct_full", 0.3),
        pileup_only=lambda w: str(config.get("clair3_pileup_only", True)).lower(),
        extra_args=lambda w: config.get("clair3_extra_args", ""),
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        if [ "{params.model}" = "/path/to/Clair3_models" ]; then
          echo "Set clair3_model_path in config/config.yaml before running Clair3." >&2
          exit 2
        fi
        {params.bin} \
          --bam_fn={input.bam} \
          --ref_fn={input.ref} \
          --threads={threads} \
          --platform={params.platform} \
          --python="$CONDA_PREFIX/bin/python" \
          --samtools="$CONDA_PREFIX/bin/samtools" \
          --model_path={params.model} \
          --output={params.outdir} \
          --include_all_ctgs \
          --snp_min_af={params.snp_min_af} \
          --indel_min_af={params.indel_min_af} \
          --var_pct_full={params.var_pct_full} \
          --ref_pct_full={params.ref_pct_full} \
          $( [ "{params.pileup_only}" = "true" ] && echo "--pileup_only" ) \
          {params.extra_args}
        OUTVCF=""
        for CAND in "{params.outdir}/merge_output.vcf.gz" "{params.outdir}/phased_merge_output.vcf.gz" "{params.outdir}/pileup.vcf.gz"; do
          if [ -s "$CAND" ]; then OUTVCF="$CAND"; break; fi
        done
        if [ -z "$OUTVCF" ]; then
          echo "Clair3 finished but expected VCF not found in {params.outdir}" >&2
          exit 3
        fi
        bcftools view -Oz -o {output} "$OUTVCF"
        tabix -p vcf -f {output}
        """


rule call_medaka_variant:
    input:
        reads=reads_fq,
        ref=lambda w: ref_fasta(),
    output:
        "vcf/{sample}.snv.vcf.gz",
    conda:
        "envs/variants.yaml"
    threads: 8
    resources:
        runtime=720,
        mem_mb=65536,
    params:
        model=lambda w: config["medaka_model"],
        workdir=lambda w: os.path.join("vcf", f"medaka_var_{w.sample}"),
    shell:
        """
        rm -rf {params.workdir}
        MWRAP="$PWD/.snakemake/medaka_wrap_var_{wildcards.sample}"
        mkdir -p "$MWRAP"
        printf '%s\n' '#!/usr/bin/env bash' 'exec "$CONDA_PREFIX/bin/python" "$CONDA_PREFIX/bin/medaka" "$@"' > "$MWRAP/medaka"
        chmod +x "$MWRAP/medaka"
        export PATH="$MWRAP:$CONDA_PREFIX/bin:$PATH"
        # Medaka 2.x: use medaka_variant (-i reads, -r ref); writes medaka.annotated.vcf under -o
        medaka_variant -i {input.reads} -r {input.ref} -o {params.workdir} -t {threads} -m {params.model} -f
        test -s {params.workdir}/medaka.annotated.vcf
        bcftools view -Oz -o {output} {params.workdir}/medaka.annotated.vcf
        tabix -p vcf -f {output}
        """


rule call_sniffles:
    input:
        "alignments/{sample}.sorted.bam",
    output:
        "vcf/{sample}.sv.vcf.gz",
    conda:
        "envs/variants.yaml"
    threads: 8
    resources:
        runtime=720,
        mem_mb=32768,
    shell:
        """
        "$CONDA_PREFIX/bin/python" "$CONDA_PREFIX/bin/sniffles" --input {input} --vcf {output} --threads {threads}
        tabix -p vcf -f {output}
        """


# ---------------------------------------------------------------------------
rule unique_post_snvs:
    input:
        pre=lambda w: f"vcf/{ref_sample()}.snv.vcf.gz",
        post=lambda w: f"vcf/{query_sample()}.snv.vcf.gz",
    output:
        isec=directory("vcf/isec_snvs"),
        vcf="vcf/unique_post.snvs.vcf.gz",
    conda:
        "envs/variants.yaml"
    resources:
        runtime=60,
        mem_mb=8192,
    shell:
        """
        rm -rf {output.isec}
        bcftools isec -p {output.isec} -n=1 -w1 {input.pre} {input.post}
        ISO="{output.isec}/0001.vcf"
        ISOGZ="{output.isec}/0001.vcf.gz"
        if [ -f "$ISO" ]; then
          bcftools view -Oz -o {output.vcf} "$ISO"
        elif [ -f "$ISOGZ" ]; then
          bcftools view -Oz -o {output.vcf} "$ISOGZ"
        else
          bcftools view --header-only -Oz -o {output.vcf} {input.post}
        fi
        tabix -p vcf -f {output.vcf}
        """


rule unique_post_svs:
    input:
        pre=lambda w: f"vcf/{ref_sample()}.sv.vcf.gz",
        post=lambda w: f"vcf/{query_sample()}.sv.vcf.gz",
    output:
        isec=directory("vcf/isec_svs"),
        vcf="vcf/unique_post.svs.vcf.gz",
    conda:
        "envs/variants.yaml"
    resources:
        runtime=60,
        mem_mb=8192,
    shell:
        """
        rm -rf {output.isec}
        bcftools isec -p {output.isec} -n=1 -w1 {input.pre} {input.post}
        ISO="{output.isec}/0001.vcf"
        ISOGZ="{output.isec}/0001.vcf.gz"
        if [ -f "$ISO" ]; then
          bcftools view -Oz -o {output.vcf} "$ISO"
        elif [ -f "$ISOGZ" ]; then
          bcftools view -Oz -o {output.vcf} "$ISOGZ"
        else
          bcftools view --header-only -Oz -o {output.vcf} {input.post}
        fi
        tabix -p vcf -f {output.vcf}
        """


# ---------------------------------------------------------------------------
rule annotate_prokka:
    input:
        ref=lambda w: ref_fasta(),
    output:
        gff=f"annotation/prokka/{ref_sample()}/{ref_sample()}.gff",
        faa=f"annotation/prokka/{ref_sample()}/{ref_sample()}.faa",
    conda:
        "envs/annotation.yaml"
    threads: 8
    resources:
        runtime=720,
        mem_mb=32768,
    params:
        outdir=lambda w: f"annotation/prokka/{ref_sample()}",
        prefix=lambda w: ref_sample(),
    shell:
        """
        mkdir -p {params.outdir}
        prokka --cpus {threads} --outdir {params.outdir} --prefix {params.prefix} --force {input.ref}
        """


rule build_snpeff_database:
    input:
        fasta=lambda w: ref_fasta(),
        gff=lambda w: f"annotation/prokka/{ref_sample()}/{ref_sample()}.gff",
        ffn=lambda w: f"annotation/prokka/{ref_sample()}/{ref_sample()}.ffn",
        faa=lambda w: f"annotation/prokka/{ref_sample()}/{ref_sample()}.faa",
    output:
        bin=snpeff_db_bin(),
        cfg=snpeff_config_path(),
    conda:
        "envs/annotation.yaml"
    resources:
        runtime=120,
        mem_mb=32768,
    params:
        genome=lambda w: snpeff_genome_id(),
    shell:
        """
        set -euo pipefail
        export JAVA_HOME="${{CONDA_PREFIX}}"
        G="{params.genome}"
        ROOT="$PWD/annotation/snpeff"
        DATADIR="$ROOT/data"
        mkdir -p "$DATADIR/$G"
        cp {input.fasta} "$DATADIR/$G/sequences.fa"
        awk '/^##FASTA/ {{ exit }} {{ print }}' {input.gff} > "$DATADIR/$G/genes.gff"
        # SnpEff transcript IDs are TRANSCRIPT_<locus>; Prokka FASTA is ><locus> only.
        awk '/^>/{{ sub(/^>/, ">TRANSCRIPT_") }} 1' {input.ffn} > "$DATADIR/$G/cds.fa"
        awk '/^>/{{ sub(/^>/, ">TRANSCRIPT_") }} 1' {input.faa} > "$DATADIR/$G/protein.fa"
        CFG="$ROOT/snpEff.config"
        mkdir -p "$ROOT"
        printf '%s\n' \\
          '# SnpEff custom DB (Prokka on reference_sample assembly)' \\
          "data.dir = $ROOT/data/" \\
          '' \\
          "${{G}}.genome : ${{G}}" \\
          > "$CFG"
        snpEff build -gff3 -v "$G" -c "$CFG"
        """


rule annotate_snpeff:
    input:
        vcf="vcf/{sample}.snv.vcf.gz",
        db=snpeff_db_bin(),
        cfg=snpeff_config_path(),
    output:
        "vcf/{sample}.snv.snpeff.vcf.gz",
    conda:
        "envs/annotation.yaml"
    threads: 2
    resources:
        runtime=120,
        mem_mb=16384,
    params:
        genome=lambda w: snpeff_genome_id(),
    shell:
        """
        set -euo pipefail
        export JAVA_HOME="${{CONDA_PREFIX}}"
        OUT="$PWD/{output}"
        TMP="${{OUT}}.tmp.$$$$"
        snpEff -c "$PWD/{input.cfg}" -v {params.genome} "$PWD/{input.vcf}" | gzip -c > "$TMP"
        mv -f "$TMP" "$OUT"
        """


