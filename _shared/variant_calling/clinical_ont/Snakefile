rule filter_highconf_variants:
    input:
        medaka=lambda w: f"vcf/{highconf_sample()}.snv.snpeff.vcf.gz",
        clair3=lambda w: f"vcf/{highconf_sample()}.clair3.snpeff.vcf.gz",
        anno="tables/mutations.tsv",
        ref=lambda w: ref_fasta(),
        hard_regions=lambda w: config.get("highconf_hard_regions", "resources/hard_regions.bed"),
        focus_catalog=lambda w: config.get("wta_envelope_catalog", "resources/wta_envelope_gene_catalog.yaml"),
        focus_tags=lambda w: config.get("wta_focus_locus_tags", "resources/focus_locus_tags.txt"),
    output:
        vcf=f"vcf/{highconf_sample()}.highconf.vcf.gz",
        tsv="tables/variants_highconf_summary.tsv",
    conda:
        "envs/variant_postprocess.yaml"
    params:
        sample=lambda w: highconf_sample(),
        medaka_min_qual=lambda w: config.get("highconf_medaka_min_qual", 3),
        medaka_min_dp=lambda w: config.get("highconf_medaka_min_dp", 10),
        clair3_min_qual=lambda w: config.get("highconf_clair3_min_qual", 8),
        clair3_min_dp=lambda w: config.get("highconf_clair3_min_dp", 10),
        medaka_solo_min_qual=lambda w: config.get("highconf_medaka_solo_min_qual", 30),
        medaka_solo_min_dp=lambda w: config.get("highconf_medaka_solo_min_dp", 15),
        medaka_solo_min_af=lambda w: config.get("highconf_medaka_solo_min_af", 0.9),
        positive_controls=lambda w: config.get(
            "highconf_positive_controls",
            "contig_2:848821:G:C,contig_2:1486788:TA:T,contig_2:1646692:G:A",
        ),
        allow_medaka_only=lambda w: str(config.get("highconf_allow_medaka_only_in_hard_regions", True)).lower(),
    resources:
        runtime=120,
        mem_mb=8192,
    shell:
        """
        set -euo pipefail
        mkdir -p vcf tables
        TMPM=vcf/.tmp.{params.sample}.medaka.norm.vcf.gz
        TMPC=vcf/.tmp.{params.sample}.clair3.norm.vcf.gz
        TMPV=vcf/.tmp.{params.sample}.highconf.vcf
        bcftools norm -f {input.ref} -m-any -Oz -o "$TMPM" {input.medaka}
        tabix -p vcf -f "$TMPM"
        bcftools norm -f {input.ref} -m-any -Oz -o "$TMPC" {input.clair3}
        tabix -p vcf -f "$TMPC"
        "$CONDA_PREFIX/bin/python" scripts/filter_highconf_variants.py \
          --medaka-vcf "$TMPM" \
          --clair3-vcf "$TMPC" \
          --annotation-tsv {input.anno} \
          --hard-regions {input.hard_regions} \
          --focus-catalog {input.focus_catalog} \
          --focus-locus-tags {input.focus_tags} \
          --sample {params.sample} \
          --medaka-min-qual {params.medaka_min_qual} \
          --medaka-min-dp {params.medaka_min_dp} \
          --clair3-min-qual {params.clair3_min_qual} \
          --clair3-min-dp {params.clair3_min_dp} \
          --medaka-solo-min-qual {params.medaka_solo_min_qual} \
          --medaka-solo-min-dp {params.medaka_solo_min_dp} \
          --medaka-solo-min-af {params.medaka_solo_min_af} \
          --positive-controls '{params.positive_controls}' \
          --allow-medaka-only-in-hard-regions {params.allow_medaka_only} \
          --output-vcf "$TMPV" \
          --output-summary {output.tsv}
        bgzip -f -c "$TMPV" > {output.vcf}
        tabix -p vcf -f {output.vcf}
        rm -f "$TMPV" "$TMPM" "$TMPM.tbi" "$TMPC" "$TMPC.tbi"
        """


rule wta_envelope_scan:
    input:
        summary="tables/variants_highconf_summary.tsv",
        catalog=lambda w: config.get("wta_envelope_catalog", "resources/wta_envelope_gene_catalog.yaml"),
        focus_tags=lambda w: config.get("wta_focus_locus_tags", "resources/focus_locus_tags.txt"),
    output:
        tsv="tables/variants_WTA_envelope.tsv",
